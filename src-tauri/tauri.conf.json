{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockApp",
  "version": "../package.json",
  "identifier": "tw.personal.stockapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StockApp",
        "width": 400,
        "height": 760,
        "resizable": false,
        "skipTaskbar": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyNTlCNzdCMzRDQ0IzQkQKUldTOXM4dzBlN2RaOGdPa3RZbG1uMEZBcHRJdVJJZnhQRjVSZlBwaXpxbVN2OHUwUmxLcGIwc2gK",
      "endpoints": [
        "https://github.com/satanbaby/StockApp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
