{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "即時台股",
  "version": "../package.json",
  "identifier": "tw.personal.stockapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "即時台股",
        "width": 400,
        "height": 760,
        "resizable": false,
        "skipTaskbar": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-TW"
      }
    }
  }
}
